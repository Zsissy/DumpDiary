PORT=8080
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
DOWNLOAD_DIR=/app/downloads

# App update metadata
DUMPDIARY_LATEST_VERSION_CODE=2
DUMPDIARY_LATEST_VERSION_NAME=1.1
DUMPDIARY_LATEST_VERSION_NOTES=Bug fixes and a smoother login experience.
DUMPDIARY_DOWNLOAD_PATH=/downloads/dumpdiary-1.1.apk

# SMTP settings
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=your_email@163.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_email@163.com
SMTP_STARTTLS=false
SMTP_SSL=true
