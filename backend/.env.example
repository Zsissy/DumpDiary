# Copy this file to backend/.env and fill in your real SMTP settings.

# App update metadata returned by /app/version
DUMPDIARY_LATEST_VERSION_CODE=2
DUMPDIARY_LATEST_VERSION_NAME=1.1
DUMPDIARY_LATEST_VERSION_NOTES="Bug fixes and a smoother login experience."

# SMTP settings
# Common patterns:
# - QQ / 163 often use: SMTP_PORT=465, SMTP_SSL=true, SMTP_STARTTLS=false
# - Gmail often uses:    SMTP_PORT=587, SMTP_SSL=false, SMTP_STARTTLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
